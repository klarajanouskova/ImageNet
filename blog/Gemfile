source 'https://rubygems.org'
group :jekyll_plugins do
    gem 'classifier-reborn'
    gem 'jekyll'
    gem 'jekyll-archives'
    gem 'jekyll-diagrams'
    gem 'jekyll-email-protect'
    gem 'jekyll-feed'
    gem 'jekyll-get-json'
    # jekyll-imagemagick removed — webp images are pre-built in assets/img/
    gem 'jekyll-jupyter-notebook'
    gem 'jekyll-link-attributes'
    # jekyll-minifier removed — requires native JS runtime (mini_racer)
    gem 'jekyll-paginate-v2'
    gem 'jekyll-regex-replace'
    gem 'jekyll-scholar'
    gem 'jekyll-sitemap'
    gem 'jekyll-tabs'
    gem 'jekyll-toc'
    gem 'jekyll-target-blank'
    gem 'jekyll-twitter-plugin'
    gem 'jekyll-redirect-from'
    gem 'jemoji'
    # mini_racer removed — was only needed by jekyll-minifier
    gem 'unicode_utils'
    gem 'webrick'
end
group :other_plugins do
    gem 'css_parser'
    gem 'feedjira'
    gem 'httparty'
end